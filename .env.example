# Copy to .env and fill in — .env is gitignored, never commit real keys.

DATABASE_URL=postgresql://user:password@host:port/dbname

ANTHROPIC_API_KEY=

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# Historical market-data feed. The free Alpaca data plan serves "iex"
# and refuses "sip" with HTTP 403; set to sip only on a paid plan.
ALPACA_DATA_FEED=iex

FMP_API_KEY=
